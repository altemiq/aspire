<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="altemiq" value="https://nuget.pkg.github.com/altemiq/index.json" />
    <add key="aspire" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet9/nuget/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget">
      <package pattern="*" />
      <package pattern="Aspire.Hosting.AWS" />
    </packageSource>
    <packageSource key="altemiq">
      <package pattern="Altemiq.Aspire.Hosting.*" />
    </packageSource>
    <packageSource key="aspire">
      <package pattern="Aspire*" />
    </packageSource>
  </packageSourceMapping>
</configuration>